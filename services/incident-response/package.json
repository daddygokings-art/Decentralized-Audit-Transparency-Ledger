{
  "name": "audit-ledger-incident-response",
  "version": "0.1.0",
  "private": true,
  "description": "In-cluster incident response webhook receiver for the AuditLedger runtime-security (Falco) stack",
  "main": "server.ts",
  "scripts": {
    "start": "ts-node server.ts",
    "dev": "ts-node-dev --respawn --transpile-only server.ts",
    "test": "jest"
  },
  "dependencies": {
    "@types/node": "^20.12.12"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.12.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleFileExtensions": ["ts", "js", "json"],
    "testMatch": ["**/*.test.ts"]
  }
}
