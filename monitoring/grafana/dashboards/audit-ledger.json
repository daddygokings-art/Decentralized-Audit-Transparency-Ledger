{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "AuditLedger contract health, event activity, and key performance metrics",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Event Rate (events/min)",
      "description": "Number of new events logged per minute",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(audit_ledger_total_events[1m])",
          "legendFormat": "events/min",
          "refId": "A"
        },
        {
          "expr": "rate(audit_ledger_total_events[1h])",
          "legendFormat": "events/hr (scaled)",
          "refId": "B"
        }
      ],
      "options": { "tooltip": { "mode": "multi" } }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Total Events vs Global Max",
      "description": "Current total events compared to global maximum",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "audit_ledger_total_events",
          "legendFormat": "Total Events",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "percentage",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          },
          "min": 0,
          "max": 100,
          "unit": "short"
        }
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Storage Usage (%)",
      "description": "Estimated storage utilisation based on event count",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "audit_ledger_storage_usage_percent",
          "legendFormat": "Storage %",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          },
          "min": 0,
          "max": 100,
          "unit": "percent"
        }
      }
    },
    {
      "id": 4,
      "type": "piechart",
      "title": "Events by Type",
      "description": "Distribution of events across all event types",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "audit_ledger_events_by_type",
          "legendFormat": "{{event_type}}",
          "refId": "A"
        }
      ],
      "options": { "pieType": "pie", "tooltip": { "mode": "multi" } }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Top Submitters",
      "description": "Most active event submitters",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "topk(10, audit_ledger_events_by_submitter)",
          "legendFormat": "{{submitter}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Recent Events",
      "description": "Most recently logged events",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "audit_ledger_recent_event_timestamp",
          "legendFormat": "{{event_id}} | {{event_type}} | {{submitter}}",
          "refId": "A",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "labelsToFields", "options": {} },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "event_id": "Event ID",
              "event_type": "Type",
              "submitter": "Submitter",
              "Value": "Timestamp"
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Event Logging Rate",
      "description": "Events logged per second since last scrape",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "audit_ledger_event_logging_rate",
          "legendFormat": "events/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "unit": "ops"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Query Latency (ms)",
      "description": "P50, P95, P99 contract query latency",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(audit_ledger_query_duration_ms_bucket[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(audit_ledger_query_duration_ms_bucket[5m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(audit_ledger_query_duration_ms_bucket[5m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Query Rate by Method",
      "description": "Successful and failed queries per second",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "targets": [
        {
          "expr": "sum by (method) (rate(audit_ledger_query_total{status=\"ok\"}[5m]))",
          "legendFormat": "{{method}} ok",
          "refId": "A"
        },
        {
          "expr": "sum by (method) (rate(audit_ledger_query_total{status=\"error\"}[5m]))",
          "legendFormat": "{{method}} error",
          "refId": "B"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Error Rate by Category",
      "description": "Errors broken down by category",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "sum by (category) (rate(audit_ledger_error_total[5m]))",
          "legendFormat": "{{category}}",
          "refId": "A"
        },
        {
          "expr": "sum by (error_type) (rate(audit_ledger_rpc_errors_total[5m]))",
          "legendFormat": "rpc: {{error_type}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" }
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Scrape Duration",
      "description": "Time taken for each full scrape cycle",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(audit_ledger_scrape_duration_ms_bucket[5m]))",
          "legendFormat": "scrape p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(audit_ledger_scrape_duration_ms_bucket[5m]))",
          "legendFormat": "scrape p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms" }
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Governance",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 }
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Owners",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 41 },
      "targets": [
        {
          "expr": "audit_ledger_governance_owners",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Required Sigs",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 41 },
      "targets": [
        {
          "expr": "audit_ledger_governance_required_signatures",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Paused",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 41 },
      "targets": [
        {
          "expr": "audit_ledger_governance_paused",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "mappings": [
          { "type": "value", "options": { "0": { "text": "Active", "color": "green" }, "1": { "text": "Paused", "color": "red" } } }
        ],
        "colorMode": "background"
      }
    },
    {
      "id": 16,
      "type": "stat",
      "title": "Emission Mode",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 41 },
      "targets": [
        {
          "expr": "audit_ledger_governance_emission_mode",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "mappings": [
          { "type": "value", "options": { "0": { "text": "None" }, "1": { "text": "Normal" }, "2": { "text": "Low Cost" } } }
        ],
        "colorMode": "background"
      }
    },
    {
      "id": 17,
      "type": "stat",
      "title": "Allowlist",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 41 },
      "targets": [
        {
          "expr": "audit_ledger_governance_allowlist_enabled",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "mappings": [
          { "type": "value", "options": { "0": { "text": "Disabled" }, "1": { "text": "Enabled" } } }
        ],
        "colorMode": "background"
      }
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Webhooks",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 41 },
      "targets": [
        {
          "expr": "audit_ledger_governance_webhooks",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background"
      }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Average Gas Cost per Event",
      "description": "Mean gas/fee cost per log_event invocation over time",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 45 },
      "targets": [
        {
          "expr": "audit_ledger_avg_gas_cost",
          "legendFormat": "avg gas cost",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Events by Category",
      "description": "Event counts per category over time",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 45 },
      "targets": [
        {
          "expr": "audit_ledger_category_count",
          "legendFormat": "{{category}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Privacy Snapshot",
      "description": "Latest aggregated privacy metrics snapshot",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 53 },
      "targets": [
        {
          "expr": "audit_ledger_privacy_dsrs_total",
          "legendFormat": "DSRs",
          "refId": "A"
        },
        {
          "expr": "audit_ledger_privacy_breaches_total",
          "legendFormat": "Breaches",
          "refId": "B"
        },
        {
          "expr": "audit_ledger_privacy_dpia_rate",
          "legendFormat": "DPIA %",
          "refId": "C"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "DIDs Registered",
      "description": "Total decentralized identifiers registered for submitters",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 53 },
      "targets": [
        {
          "expr": "audit_ledger_dids_total",
          "legendFormat": "DIDs",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 23,
      "type": "stat",
      "title": "SSI Verifications",
      "description": "Total SSI credential verifications performed",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 53 },
      "targets": [
        {
          "expr": "audit_ledger_ssi_verifications_total",
          "legendFormat": "Verifications",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 24,
      "type": "stat",
      "title": "Avg Reputation Score",
      "description": "Average reputation score across all submitters",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 53 },
      "targets": [
        {
          "expr": "avg(audit_ledger_reputation_score)",
          "legendFormat": "Avg Score",
          "refId": "A"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Privacy Events",
      "description": "DSRs and breach incidents over time",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 57 },
      "targets": [
        {
          "expr": "rate(audit_ledger_privacy_dsrs_total[5m])",
          "legendFormat": "DSRs/min",
          "refId": "A"
        },
        {
          "expr": "rate(audit_ledger_privacy_breaches_total[5m])",
          "legendFormat": "Breaches/min",
          "refId": "B"
        }
      ]
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "Reputation Tier Distribution",
      "description": "Submitters per reputation tier",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 57 },
      "targets": [
        {
          "expr": "sum by (tier) (audit_ledger_reputation_tier)",
          "legendFormat": "{{tier}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 27,
      "type": "bargauge",
      "title": "Top Reputation Scores",
      "description": "Highest reputation scores among submitters",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 65 },
      "targets": [
        {
          "expr": "topk(10, audit_ledger_reputation_score)",
          "legendFormat": "{{submitter}}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "id": 28,
      "type": "piechart",
      "title": "DID Methods",
      "description": "Distribution of DID registration methods",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 65 },
      "targets": [
        {
          "expr": "sum by (method) (audit_ledger_did_method_total)",
          "legendFormat": "{{method}}",
          "refId": "A"
        }
      ],
      "options": { "pieType": "pie", "tooltip": { "mode": "multi" } }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 37,
  "style": "dark",
  "tags": ["soroban", "audit", "stellar"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "AuditLedger Contract Dashboard",
  "uid": "audit-ledger-main",
  "version": 1
}
