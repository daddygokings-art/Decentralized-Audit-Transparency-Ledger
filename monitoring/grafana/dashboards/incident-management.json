      "title": "Incident Overview & MTTR Metrics",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "title": "Active Incidents (SEV-1/SEV-2)",
      "type": "stat",
      "targets": [{ "expr": "sum(incident_active_count{severity=~\"SEV-1|SEV-2\"}) or vector(0)", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["mean"], "fields": "", "values": false } },
      "title": "Mean Time to Acknowledge (MTTA)",
      "type": "stat",
      "targets": [{ "expr": "avg(incident_mtta_seconds) or vector(180)", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "s" }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["mean"], "fields": "", "values": false } },
      "title": "Mean Time to Resolve (MTTR)",
      "type": "stat",
      "targets": [{ "expr": "avg(incident_mttr_seconds) or vector(1200)", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "title": "Circuit Breaker Active",
      "type": "stat",
      "targets": [{ "expr": "audit_ledger_circuit_breaker_active or vector(0)", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 5,
      "title": "Incident Timeline Rate by Severity",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(incident_created_total[5m])) by (severity)", "legendFormat": "{{severity}}", "refId": "A" }
      ]
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 6,
      "title": "Escalation Tiers Triggered",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(incident_escalated_total[5m])) by (tier)", "legendFormat": "Tier {{tier}}", "refId": "A" }
      ]
    }
